# Copy this file to .env for local overrides. Defaults are for local development only.
POSTGRES_DB=conference
POSTGRES_USER=conference
POSTGRES_PASSWORD=conference_dev_password

FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
WHISPERLIVE_PORT=9090
LIBRETRANSLATE_PORT=5001
ELASTICSEARCH_PORT=9200

# Optional AI features. Keep real keys in .env; never commit them.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
ENHANCED_WHISPER_MODEL=small
MAX_MEDIA_BYTES=1073741824

# Optional Dash0 export. Fill these in your .env (never in this file: it is committed).
# DASH0_AUTH_TOKEN: paste the auth_... token from Dash0 > Settings > Auth Tokens.
# compose.yaml turns it into the OTLP Authorization header for you.
DASH0_AUTH_TOKEN=
DASH0_DATASET=default
# Your Dash0 OTLP/HTTP endpoint, e.g. https://ingress.<region>.aws.dash0.com (no port).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Set these three to otlp to send telemetry; none keeps it off.
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
